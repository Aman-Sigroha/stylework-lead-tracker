# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Neon and other hosted providers typically require SSL in the connection string)
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Comma-separated allowed origins for CORS (required in production for credentialed requests)
# CORS_ORIGIN=http://localhost:5173

# Authentication (required)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial admin user (db:create-admin only; never commit real values)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
